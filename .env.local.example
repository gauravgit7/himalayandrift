# =============================================================================
# TVS Nepal Ride Operations Platform - Environment Variables
# Copy this file to .env.local and fill in all values before running
# NEVER commit .env.local to version control
# =============================================================================

# ── Supabase ──────────────────────────────────────────────────────────────────
# Found in: Supabase dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
# Service role key - server-side only, NEVER expose to the browser
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── OpenWeather ───────────────────────────────────────────────────────────────
# Found in: openweathermap.org → My API Keys
OPENWEATHER_API_KEY=your-openweather-api-key-here

# ── App ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
