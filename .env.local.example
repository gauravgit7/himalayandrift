# =============================================================================
# Himalayan Drift - Environment Variables
# Copy this file to .env.local and fill in all values before running
# NEVER commit .env.local to version control
# =============================================================================

# ── Supabase ──────────────────────────────────────────────────────────────────
# Found in: Supabase dashboard → Project Settings → API
# Use a Supabase project created for Himalayan Drift only. Do not reuse another
# project's keys.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
# Service role key - server-side only, NEVER expose to the browser
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── Admin access ──────────────────────────────────────────────────────────────
# Comma-separated list of admin email addresses. Must be the FULL address
# including the domain - a truncated value here silently redirects /admin to the
# homepage. The admin layout and middleware both log a warning naming the
# mismatch, so check the dev-server terminal if admin access bounces you.
# Read server-side: RESTART the dev server after changing this.
ADMIN_EMAILS=you@example.com

# ── OpenWeather ───────────────────────────────────────────────────────────────
# Optional. Found in: openweathermap.org → My API Keys
# If unset, the weather widget is skipped rather than erroring.
OPENWEATHER_API_KEY=your-openweather-api-key-here

# ── Web Push (VAPID) ──────────────────────────────────────────────────────────
# Optional - required only for push notifications.
# Generate a FRESH keypair for this project: node scripts/generate-vapid-keys.mjs
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key-here
VAPID_PRIVATE_KEY=your-vapid-private-key-here
VAPID_SUBJECT=mailto:you@example.com

# ── Cron ──────────────────────────────────────────────────────────────────────
# Optional in development; required in production. Shared secret that guards
# /api/cron/ride-reminders and /api/push/send against public callers.
CRON_SECRET=generate-a-long-random-string

# ── App ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Used to build absolute URLs in the iCal feed.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
